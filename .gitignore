# Виртуальное окружение: создаётся локально скриптом setup.cmd
.venv/
__pycache__/
*.py[cod]

# Логи диагностики: пишутся во время работы, к запуску отношения не имеют
logs/
*.jsonl

# Личная калибровка камеры: у каждого своя комната, своя камера и свой стол.
# В репозитории лежит только .gitkeep, чтобы папка существовала после клона.
config/calibration/*.json

# ОС и редакторы
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
